{
  "branch_id": "HN-001",
  "confidence_threshold": 0.75,
  "dedupe_window_seconds": 30,
  "cameras": [
    {
      "camera_id": "cam-entrance-01",
      "rtsp_url": "rtsp://admin:password@192.168.1.101:554/Streaming/Channels/102",
      "enabled": true,
      "fps_target": 4,
      "roi": { "x": 0.1, "y": 0.05, "w": 0.8, "h": 0.7 }
    },
    {
      "camera_id": "cam-pos-01",
      "rtsp_url": "rtsp://admin:password@192.168.1.102:554/Streaming/Channels/102",
      "enabled": true,
      "fps_target": 4,
      "roi": { "x": 0.2, "y": 0.1, "w": 0.6, "h": 0.65 }
    }
  ],
  "models": {
    "detection": {
      "name": "yunet",
      "xml_path": "models/face-detection-yunet-2023mar.xml",
      "score_threshold": 0.6,
      "nms_threshold": 0.3,
      "input_size": [320, 320]
    },
    "recognition": {
      "name": "mobilefacenet",
      "xml_path": "models/mobilefacenet-arcface.xml",
      "embedding_dim": 128
    },
    "device": "GPU",
    "num_requests": 1
  },
  "matching": {
    "backend": "faiss",
    "gallery_path": "data/gallery.json",
    "metric": "cosine",
    "top_k": 1
  },
  "hq": {
    "api_base_url": "https://nas.hq.local/api/v1",
    "webhook_path": "/edge/face-events",
    "gallery_sync_path": "/edge/face-gallery",
    "timeout_seconds": 5,
    "retry_max": 3,
    "api_key_env": "EDGE_FACE_API_KEY"
  },
  "storage": {
    "sqlite_path": "data/edge_face.db",
    "sync_batch_size": 50,
    "sync_interval_seconds": 30
  },
  "service": {
    "poll_interval_ms": 50,
    "log_level": "INFO",
    "log_dir": "logs"
  }
}
